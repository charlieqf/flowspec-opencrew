# OpenCrew two-node deploy config template.
# Copy to scripts/deploy/00_config.env and fill local values before running scripts.

# ---- Production host ----
PROD_REPO="/Users/macmini-1/work/code/OpenCrew"
PROD_DATA="/Users/macmini-1/.opencrew"

# ---- Test host ----
TEST_HOST="macmini-4@100.76.9.120"
TEST_RSYNC_HOST="macmini-4@192.168.0.5"
TEST_UID="501"
TEST_HOME="/Users/macmini-4"
TEST_REPO="/Users/macmini-4/work/code/OpenCrew"
TEST_DATA="/Users/macmini-4/.opencrew"
TEST_OPENCODE_SRC="/Users/macmini-4/work/code/opencode"

# ---- Code ----
DEPLOY_REF="main"
REPO_URL="$(git -C "$PROD_REPO" remote get-url origin 2>/dev/null || echo '<OpenCrew repo URL>')"

# ---- Ports ----
BACKEND_PORT="8011"
FRONTEND_PORT="18080"
PG_PORT="5433"
OPENCODE_PORT="4096"

# ---- Database ----
DB_USER="opencrew"
DB_PASS="CHANGE_ME"
DB_NAME="opencrew"

# ---- Path rewrite ----
PATH_OLD="/Users/macmini-1/"
PATH_NEW="/Users/macmini-4/"

# ---- OpenCrew-owned OpenCode Basic Auth ----
OPENCODE_USER="opencode"
OPENCODE_PASS="CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE"

# ---- Tunnel ----
TUNNEL_LOG="/tmp/opencrew-tunnel.log"

# ---- launchd agents disabled on the test host to free ports ----
MARKER_AGENTS=(com.marker.public-api com.marker.public-worker com.marker.public-redis com.marker.public-postgres)
OPENCODE_AGENTS=(com.local.opencode-gateway com.local.opencode-server)
