{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencrew.local/schemas/composite_candidate.schema.json",
  "title": "Media Library Composite Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "media_library_composite_candidate_v1"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "claimRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["people", "objects", "scene", "action"],
      "properties": {
        "people": {"$ref": "#/$defs/stringArray"},
        "objects": {"$ref": "#/$defs/stringArray"},
        "scene": {"$ref": "#/$defs/stringArray"},
        "action": {"type": "array", "maxItems": 0}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragment_id",
        "asset_id",
        "scheme",
        "start_ms",
        "end_ms",
        "duration_ms",
        "title",
        "summary",
        "dialogue_text",
        "visual_summary",
        "keywords",
        "people",
        "objects",
        "scene",
        "action",
        "dialogue_refs",
        "visual_refs",
        "visual_claim_refs",
        "keyframe_refs",
        "boundary_reasons",
        "confidence",
        "needs_review"
      ],
      "properties": {
        "fragment_id": {"type": "string", "pattern": "^composite_[0-9]{4,}$"},
        "asset_id": {"type": "string", "minLength": 1},
        "scheme": {"const": "composite"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "duration_ms": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1500},
        "dialogue_text": {"type": ["string", "null"], "maxLength": 6000},
        "visual_summary": {"type": ["string", "null"], "maxLength": 6000},
        "keywords": {"$ref": "#/$defs/stringArray"},
        "people": {"$ref": "#/$defs/stringArray"},
        "objects": {"$ref": "#/$defs/stringArray"},
        "scene": {"type": ["string", "null"], "maxLength": 256},
        "action": {"type": "null"},
        "dialogue_refs": {"$ref": "#/$defs/stringArray"},
        "visual_refs": {"$ref": "#/$defs/stringArray"},
        "visual_claim_refs": {"$ref": "#/$defs/claimRefs"},
        "keyframe_refs": {"$ref": "#/$defs/stringArray"},
        "boundary_reasons": {"$ref": "#/$defs/stringArray"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "needs_review": {"type": "boolean"}
      }
    }
  }
}
