{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencrew.local/schemas/opencut-v1/visual_semantic_input_v2.schema.json",
  "title": "OpenCut V1 frozen four-frame visual-semantic input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "source_version",
    "visual_structure_run_id",
    "visual_structure_result_hash",
    "sampling_strategy",
    "keyframes",
    "visual_prompt_version",
    "model_config_id",
    "allow_cloud_visual_data_transfer"
  ],
  "properties": {
    "schema_version": {"const": "media_library_visual_semantic_input_v2"},
    "asset_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_version": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "visual_structure_run_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "visual_structure_result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sampling_strategy": {"const": "scene_uniform_4_v1"},
    "keyframes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyframe_id", "image_sha256"],
        "properties": {
          "keyframe_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "visual_prompt_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "model_config_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "allow_cloud_visual_data_transfer": {"type": "boolean"}
  }
}
