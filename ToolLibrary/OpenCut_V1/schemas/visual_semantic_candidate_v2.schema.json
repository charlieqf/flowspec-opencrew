{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencrew.local/schemas/opencut-v1/visual_semantic_candidate_v2.schema.json",
  "title": "OpenCut V1 four-frame visual-semantic candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {
      "const": "media_library_visual_semantic_candidate_v2"
    },
    "asset_id": {"type": "string"},
    "source_version": {"type": "string"},
    "visual_structure_run_id": {"type": "string"},
    "visual_structure_result_hash": {"type": "string"},
    "sampling_strategy": {"const": "scene_uniform_4_v1"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "stringArray": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "evidenceArray": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragment_id",
        "start_ms",
        "end_ms",
        "keyframe_refs",
        "visual_summary",
        "people",
        "objects",
        "scene",
        "action",
        "keywords",
        "claim_evidence",
        "confidence",
        "needs_review"
      ],
      "properties": {
        "fragment_id": {"$ref": "#/$defs/nonEmptyString"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "duration_ms": {"type": "integer", "minimum": 1},
        "keyframe_refs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "visual_summary": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "people": {"$ref": "#/$defs/stringArray"},
        "objects": {"$ref": "#/$defs/stringArray"},
        "scene": {"type": ["string", "null"], "maxLength": 256},
        "action": {"type": "null"},
        "keywords": {"$ref": "#/$defs/stringArray"},
        "claim_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["people", "objects", "scene", "action"],
          "properties": {
            "people": {"$ref": "#/$defs/evidenceArray"},
            "objects": {"$ref": "#/$defs/evidenceArray"},
            "scene": {"$ref": "#/$defs/evidenceArray"},
            "action": {"type": "array", "maxItems": 0}
          }
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "needs_review": {"type": "boolean"}
      }
    }
  }
}
