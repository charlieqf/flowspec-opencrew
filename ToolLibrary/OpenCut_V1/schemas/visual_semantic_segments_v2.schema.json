{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencrew.local/schemas/opencut-v1/visual_semantic_segments_v2.schema.json",
  "title": "OpenCut V1 published four-frame visual-semantic segments",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "source_version",
    "analysis_run_id",
    "visual_structure_run_id",
    "visual_structure_result_hash",
    "sampling_strategy",
    "visual_prompt_version",
    "model_config_id",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "media_library_visual_semantic_v2"},
    "asset_id": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysis_run_id": {"type": "string", "minLength": 1},
    "visual_structure_run_id": {"type": "string", "minLength": 1},
    "visual_structure_result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sampling_strategy": {"const": "scene_uniform_4_v1"},
    "visual_prompt_version": {"type": "string", "minLength": 1},
    "model_config_id": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "visual_semantic_candidate_v2.schema.json#/$defs/item"
      }
    }
  }
}
