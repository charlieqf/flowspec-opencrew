{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencrew/flowspec/proposed/ToolRegistry.schema.json",
  "title": "FlowSpec Tool Registry (PROPOSED executable binding)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "version", "tools"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "registry_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id", "version", "entrypoint", "type", "side_effect_class",
        "reads", "consumes", "produces", "writes"
      ],
      "properties": {
        "tool_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z_][A-Za-z0-9_]*$" },
        "type": { "enum": ["script", "command", "service", "model", "agent", "confirm", "suspend", "subprocess", "noop"] },
        "description": { "type": "string" },
        "side_effect_class": { "enum": ["pure", "idempotent", "reconcilable", "non_idempotent"] },
        "reads": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "consumes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "produces": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "writes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "mock": { "type": "boolean" },
        "supports_reconciliation": { "type": "boolean" },
        "supports_checkpoint": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "side_effect_class": { "const": "reconcilable" } }, "required": ["side_effect_class"] },
          "then": { "required": ["supports_reconciliation"], "properties": { "supports_reconciliation": { "const": true } } }
        }
      ]
    }
  }
}
