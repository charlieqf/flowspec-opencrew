{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencrew/flowspec/proposed/AIExecutionProfile.schema.json",
  "title": "FlowSpec AI Execution Profile (PROPOSED)",
  "description": "Bounded, auditable policy for a model invocation or an agent execution. It contains no credentials and never makes streaming deltas authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "version", "kind", "model", "budget", "data_policy", "output", "streaming"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "kind": { "enum": ["model", "agent"] },
    "model": { "$ref": "#/$defs/modelPolicy" },
    "budget": { "$ref": "#/$defs/budget" },
    "data_policy": { "$ref": "#/$defs/dataPolicy" },
    "output": { "$ref": "#/$defs/outputPolicy" },
    "streaming": { "$ref": "#/$defs/streamingPolicy" },
    "agent": { "$ref": "#/$defs/agentPolicy" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "agent" } }, "required": ["kind"] },
      "then": {
        "required": ["agent"],
        "properties": {
          "budget": { "required": ["max_turns", "max_tool_calls"] }
        }
      },
      "else": { "not": { "required": ["agent"] } }
    }
  ],
  "$defs": {
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_id"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_revision": { "type": "string" },
        "deployment_id": { "type": "string" },
        "region": { "type": "string" }
      }
    },
    "modelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_id", "fallback_policy"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_revision": { "type": "string" },
        "deployment_id": { "type": "string" },
        "region": { "type": "string" },
        "runtime": { "type": "string" },
        "modality": { "enum": ["text", "vision", "audio", "video", "multimodal"] },
        "selection_source": { "enum": ["explicit", "run_snapshot", "approved_discovery"] },
        "fallback_policy": { "enum": ["deny", "explicit_list"] },
        "fallback_models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/modelRef" } }
      },
      "allOf": [
        {
          "if": { "properties": { "fallback_policy": { "const": "explicit_list" } }, "required": ["fallback_policy"] },
          "then": { "required": ["fallback_models"] },
          "else": { "not": { "required": ["fallback_models"] } }
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_wall_seconds"],
      "properties": {
        "max_wall_seconds": { "type": "integer", "minimum": 1 },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_media_units": {
          "description": "Modality-specific caps such as image_count, audio_seconds, or video_seconds.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        },
        "max_cost": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "max_turns": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 0 }
      },
      "dependentRequired": { "max_cost": ["currency"], "currency": ["max_cost"] },
      "anyOf": [
        { "required": ["max_input_tokens"] },
        { "required": ["max_output_tokens"] },
        { "required": ["max_media_units"] },
        { "required": ["max_cost"] }
      ]
    },
    "dataPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensitivity", "external_transfer", "redaction_required", "residency", "provider_retention", "provider_training"],
      "properties": {
        "sensitivity": { "enum": ["normal", "sensitive", "restricted"] },
        "external_transfer": { "enum": ["denied", "consent_required", "allowed"] },
        "consent_ref": { "type": "string", "minLength": 1 },
        "redaction_required": { "type": "boolean" },
        "residency": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "provider_retention": { "enum": ["denied", "zero_retention_required", "contractual", "allowed"] },
        "provider_training": { "enum": ["denied", "contractual_opt_out", "allowed"] },
        "purpose": { "type": "string" },
        "deletion_policy_ref": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "external_transfer": { "const": "consent_required" } }, "required": ["external_transfer"] },
          "then": { "required": ["consent_ref"] }
        }
      ]
    },
    "outputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation", "max_repair_attempts", "safety_policy_ref", "grounding_required", "evidence_required"],
      "properties": {
        "schema_ref": { "type": "string", "minLength": 1 },
        "validation": { "enum": ["strict", "best_effort"] },
        "max_repair_attempts": { "type": "integer", "minimum": 0, "maximum": 3 },
        "safety_policy_ref": { "type": "string", "minLength": 1 },
        "moderation_required": { "type": "boolean" },
        "grounding_required": { "type": "boolean" },
        "evidence_required": { "type": "boolean" }
      }
    },
    "streamingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "partial_output_authoritative"],
      "properties": {
        "enabled": { "type": "boolean" },
        "partial_output_authoritative": { "const": false }
      }
    },
    "agentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "session_scope", "tool_policy", "workspace_access", "network_access"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "session_scope": { "enum": ["step_attempt", "run", "business_session"] },
        "tool_policy": { "$ref": "#/$defs/toolPolicy" },
        "workspace_access": { "enum": ["none", "read_only", "step_private"] },
        "network_access": { "$ref": "#/$defs/networkPolicy" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["deny_all", "allowlist"] },
        "allowed_hosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "allowlist" } }, "required": ["mode"] },
          "then": { "required": ["allowed_hosts"] },
          "else": { "not": { "required": ["allowed_hosts"] } }
        }
      ]
    },
    "toolGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "version_constraint", "approval"],
      "properties": {
        "tool_id": { "type": "string", "minLength": 1 },
        "version_constraint": { "type": "string", "minLength": 1 },
        "approval": { "enum": ["none", "per_call", "per_execution"] },
        "max_calls": { "type": "integer", "minimum": 0 },
        "argument_policy_ref": { "type": "string" }
      }
    },
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["deny_all", "allowlist"] },
        "allowed_tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/toolGrant" } },
        "denied_tools": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "allowlist" } }, "required": ["mode"] },
          "then": { "required": ["allowed_tools"] }
        }
      ]
    }
  }
}
