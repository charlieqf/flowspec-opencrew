{
  "schema_version": "1.1",
  "profile_id": "video_creative_agent",
  "version": "1.0.0",
  "description": "Bounded creative brief agent.",
  "kind": "agent",
  "model": {
    "provider": "mock-provider",
    "model_id": "mock-creative-agent",
    "model_revision": "2026-07-24",
    "deployment_id": "demo-local",
    "region": "local",
    "runtime": "flowspec-mock-agent",
    "modality": "text",
    "selection_source": "explicit",
    "fallback_policy": "deny"
  },
  "budget": {
    "max_wall_seconds": 120,
    "max_input_tokens": 12000,
    "max_output_tokens": 3000,
    "max_cost": "0.20",
    "currency": "USD",
    "max_turns": 4,
    "max_tool_calls": 4
  },
  "data_policy": {
    "sensitivity": "sensitive",
    "external_transfer": "denied",
    "redaction_required": false,
    "residency": [
      "local"
    ],
    "provider_retention": "denied",
    "provider_training": "denied",
    "purpose": "brand creative brief",
    "deletion_policy_ref": "policy://creative-retention/v1"
  },
  "output": {
    "schema_ref": "schemas/artifacts.schema.json#/$defs/brief",
    "validation": "strict",
    "max_repair_attempts": 1,
    "safety_policy_ref": "policy://brand-safety/v2",
    "moderation_required": true,
    "grounding_required": true,
    "evidence_required": false
  },
  "streaming": {
    "enabled": true,
    "partial_output_authoritative": false
  },
  "agent": {
    "engine": "mock-agent-loop",
    "session_scope": "step_attempt",
    "tool_policy": {
      "mode": "allowlist",
      "allowed_tools": [
        {
          "tool_id": "brand_fact_lookup",
          "version_constraint": "1.x",
          "approval": "none",
          "max_calls": 4,
          "argument_policy_ref": "policy://brand-facts/v1"
        }
      ]
    },
    "workspace_access": "step_private",
    "network_access": {
      "mode": "deny_all"
    }
  }
}
