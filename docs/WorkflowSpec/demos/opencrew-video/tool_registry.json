{
  "schema_version": "1.0", "registry_id": "opencrew_video_mock_tools", "version": "1.1.0", "description": "Deterministic mock tools for the OpenCrew AI-video demo.",
  "tools": [
    { "tool_id": "build_creative_brief", "version": "1.0.0", "entrypoint": "tools:build_creative_brief", "type": "agent", "description": "Build brief.", "side_effect_class": "pure", "reads": ["project_id", "creative_revision", "brand", "product", "audience", "channel", "duration_seconds"], "consumes": [], "produces": ["CreativeBrief.json"], "writes": ["brief_hash"], "mock": true },
    { "tool_id": "plan_storyboard", "version": "1.0.0", "entrypoint": "tools:plan_storyboard", "type": "model", "description": "Plan storyboard.", "side_effect_class": "pure", "reads": ["project_id", "creative_revision", "duration_seconds"], "consumes": ["CreativeBrief.json"], "produces": ["StoryboardPlan.json"], "writes": ["dialogue_count"], "mock": true },
    { "tool_id": "review_storyboard", "version": "1.0.0", "entrypoint": "tools:review_storyboard", "type": "confirm", "description": "Review storyboard.", "side_effect_class": "idempotent", "reads": ["project_id", "creative_revision", "dialogue_count"], "consumes": ["StoryboardPlan.json"], "produces": ["StoryboardApproval.json"], "writes": ["storyboard_decision"], "mock": true },
    { "tool_id": "request_storyboard_revision", "version": "1.0.0", "entrypoint": "tools:request_storyboard_revision", "type": "service", "description": "Request storyboard revision.", "side_effect_class": "idempotent", "reads": ["project_id", "creative_revision", "storyboard_decision"], "consumes": ["StoryboardApproval.json", "StoryboardPlan.json"], "produces": ["StoryboardRevisionRequest.json"], "writes": [], "mock": true },
    { "tool_id": "generate_consistency_references", "version": "1.0.0", "entrypoint": "tools:generate_consistency_references", "type": "model", "description": "Generate references.", "side_effect_class": "reconcilable", "reads": ["project_id", "creative_revision", "storyboard_decision"], "consumes": ["CreativeBrief.json", "StoryboardPlan.json", "StoryboardApproval.json"], "produces": ["ConsistencyReferences.json"], "writes": [], "mock": true, "supports_reconciliation": true },
    { "tool_id": "generate_dialogue_audio", "version": "1.0.0", "entrypoint": "tools:generate_dialogue_audio", "type": "model", "description": "Generate dialogue audio.", "side_effect_class": "reconcilable", "reads": ["project_id", "creative_revision", "storyboard_decision"], "consumes": ["StoryboardPlan.json", "StoryboardApproval.json"], "produces": ["Audio_{asset_key}.wav"], "writes": [], "mock": true, "supports_reconciliation": true },
    { "tool_id": "create_visual_prompt", "version": "1.0.0", "entrypoint": "tools:create_visual_prompt", "type": "model", "description": "Create visual prompt.", "side_effect_class": "pure", "reads": ["project_id", "creative_revision", "storyboard_decision"], "consumes": ["CreativeBrief.json", "StoryboardPlan.json", "ConsistencyReferences.json"], "produces": ["VisualPrompt_{asset_key}.json"], "writes": [], "mock": true },
    { "tool_id": "generate_dialogue_image", "version": "1.0.0", "entrypoint": "tools:generate_dialogue_image", "type": "model", "description": "Generate image.", "side_effect_class": "reconcilable", "reads": ["project_id", "creative_revision"], "consumes": ["StoryboardPlan.json", "VisualPrompt_*.json", "ConsistencyReferences.json"], "produces": ["Image_{asset_key}.png"], "writes": [], "mock": true, "supports_reconciliation": true },
    { "tool_id": "generate_dialogue_video", "version": "1.0.0", "entrypoint": "tools:generate_dialogue_video", "type": "model", "description": "Generate video.", "side_effect_class": "reconcilable", "reads": ["project_id", "creative_revision"], "consumes": ["StoryboardPlan.json", "Image_*.png", "VisualPrompt_*.json"], "produces": ["RawVideo_{asset_key}.mp4"], "writes": [], "mock": true, "supports_reconciliation": true },
    { "tool_id": "bind_final_segment", "version": "1.0.0", "entrypoint": "tools:bind_final_segment", "type": "script", "description": "Bind segment.", "side_effect_class": "idempotent", "reads": ["project_id", "creative_revision"], "consumes": ["StoryboardPlan.json", "Audio_*.wav", "RawVideo_*.mp4"], "produces": ["FinalSegment_{asset_key}.mp4"], "writes": [], "mock": true },
    { "tool_id": "compose_master_video", "version": "1.0.0", "entrypoint": "tools:compose_master_video", "type": "script", "description": "Compose master.", "side_effect_class": "idempotent", "reads": ["project_id", "creative_revision", "dialogue_count"], "consumes": ["StoryboardPlan.json", "FinalSegment_*.mp4"], "produces": ["MasterVideo.mp4", "DeliveryManifest.json"], "writes": [], "mock": true },
    { "tool_id": "run_multimodal_qa", "version": "1.0.0", "entrypoint": "tools:run_multimodal_qa", "type": "model", "description": "Run QA.", "side_effect_class": "pure", "reads": ["project_id", "creative_revision", "qa_pass_fixture"], "consumes": ["MasterVideo.mp4", "DeliveryManifest.json", "CreativeBrief.json"], "produces": ["QAReport.json"], "writes": ["qa_passed"], "mock": true },
    { "tool_id": "request_qa_revision", "version": "1.0.0", "entrypoint": "tools:request_qa_revision", "type": "service", "description": "Request QA revision.", "side_effect_class": "idempotent", "reads": ["project_id", "creative_revision", "qa_passed"], "consumes": ["QAReport.json", "DeliveryManifest.json"], "produces": ["QARevisionRequest.json"], "writes": [], "mock": true },
    { "tool_id": "review_publish", "version": "1.0.0", "entrypoint": "tools:review_publish", "type": "confirm", "description": "Review publish.", "side_effect_class": "idempotent", "reads": ["project_id", "creative_revision", "qa_passed"], "consumes": ["MasterVideo.mp4", "QAReport.json", "DeliveryManifest.json"], "produces": ["PublishApproval.json"], "writes": ["publish_decision"], "mock": true },
    { "tool_id": "deliver_channel_asset", "version": "1.0.0", "entrypoint": "tools:deliver_channel_asset", "type": "service", "description": "Deliver asset.", "side_effect_class": "reconcilable", "reads": ["project_id", "creative_revision", "channel", "publish_decision"], "consumes": ["MasterVideo.mp4", "DeliveryManifest.json", "PublishApproval.json"], "produces": ["DeliveryReceipt.json"], "writes": ["delivered_at"], "mock": true, "supports_reconciliation": true },
    { "tool_id": "request_publish_revision", "version": "1.0.0", "entrypoint": "tools:request_publish_revision", "type": "service", "description": "Request publish revision.", "side_effect_class": "idempotent", "reads": ["project_id", "creative_revision", "publish_decision"], "consumes": ["PublishApproval.json", "QAReport.json"], "produces": ["PublishRevisionRequest.json"], "writes": [], "mock": true }
  ]
}
