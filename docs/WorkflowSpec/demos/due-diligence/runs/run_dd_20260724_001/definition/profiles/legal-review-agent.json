{
  "schema_version": "1.1",
  "profile_id": "dd_legal_review_agent",
  "version": "1.0.0",
  "description": "Bounded legal-review agent with evidence lookup only.",
  "kind": "agent",
  "model": {
    "provider": "mock-provider",
    "model_id": "mock-legal-agent",
    "model_revision": "2026-07-24",
    "deployment_id": "demo-local",
    "region": "local",
    "runtime": "flowspec-mock-agent",
    "modality": "text",
    "selection_source": "explicit",
    "fallback_policy": "deny"
  },
  "budget": {
    "max_wall_seconds": 180,
    "max_input_tokens": 32000,
    "max_output_tokens": 5000,
    "max_cost": "0.50",
    "currency": "USD",
    "max_turns": 4,
    "max_tool_calls": 8
  },
  "data_policy": {
    "sensitivity": "restricted",
    "external_transfer": "denied",
    "redaction_required": true,
    "residency": [
      "local"
    ],
    "provider_retention": "denied",
    "provider_training": "denied",
    "purpose": "matter-scoped legal candidate review",
    "deletion_policy_ref": "policy://matter-retention/v1"
  },
  "output": {
    "schema_ref": "schemas/artifacts.schema.json#/$defs/findings",
    "validation": "strict",
    "max_repair_attempts": 1,
    "safety_policy_ref": "policy://dd-ai/v1",
    "moderation_required": false,
    "grounding_required": true,
    "evidence_required": true
  },
  "streaming": {
    "enabled": false,
    "partial_output_authoritative": false
  },
  "agent": {
    "engine": "mock-agent-loop",
    "session_scope": "step_attempt",
    "tool_policy": {
      "mode": "allowlist",
      "allowed_tools": [
        {
          "tool_id": "evidence_lookup",
          "version_constraint": "1.x",
          "approval": "none",
          "max_calls": 8,
          "argument_policy_ref": "policy://matter-evidence-lookup/v1"
        }
      ]
    },
    "workspace_access": "read_only",
    "network_access": {
      "mode": "deny_all"
    }
  }
}
